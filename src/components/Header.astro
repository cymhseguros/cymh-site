---
interface Props {
  // home page: menu links are in-page anchors and the logo has an explicit size
  onHome?: boolean;
  // menu item highlighted as the current page
  active?: 'servicos' | 'nossa-historia';
  // inline style some pages set on the divider
  dividerStyle?: string;
}

const { onHome = false, active, dividerStyle } = Astro.props;
const home = onHome ? '#home' : '/';
const contact = onHome ? '#contato' : '/#contato';
---
<!-- Navbar -->
<header class="navbar" id="navbar">
  <div class="nav-container">
    <a href={home} class="logo"><img src="logo.svg" alt="CYMH Corretora de Seguros" width={onHome ? '150' : undefined} height={onHome ? '46' : undefined} /></a>
    <div class="mobile-actions">
      <a href="https://wa.me/554498102769?text=Ol%C3%A1!%20Gostaria%20de%20falar%20com%20a%20CYMH." target="_blank" class="mobile-wa-btn" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347Z"/></svg>
      </a>
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <!-- Desktop nav -->
    <nav class="nav-links">
      <a href={home}>Home</a>
      <a href="servicos.html" class={active === 'servicos' ? 'active' : undefined}>Serviços</a>
      <a href="nossa-historia.html" class={active === 'nossa-historia' ? 'active' : undefined}>Nossa História</a>
      <a href={contact}>Contato</a>
    </nav>
    <div class="nav-actions">
      <a href="https://wa.me/554498102769?text=Ol%C3%A1!%20Gostaria%20de%20falar%20com%20a%20CYMH." target="_blank" class="nav-phone">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        (44) 99810-2769
