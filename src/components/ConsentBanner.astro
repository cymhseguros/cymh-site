<!-- Cookie Consent Banner -->
<style is:inline>
  #consent-banner {
    position: fixed; bottom: 20px; left: 20px; right: 20px;
    background: #ffffff; color: #0a1e3d;
    padding: 1.5rem; border-radius: 3px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    z-index: 10000; display: none;
    flex-direction: column; gap: 1rem;
    max-width: 500px; border-left: 4px solid #0a1e3d;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  @media(min-width: 768px) {
    #consent-banner { flex-direction: row; align-items: center; max-width: none; bottom: 30px; left: 30px; right: 30px; gap: 2rem; }
  }
  .consent-text { font-size: 0.88rem; line-height: 1.5; flex: 1; }
  .consent-btns { display: flex; gap: 0.75rem; white-space: nowrap; }
  .btn-consent {
    padding: 0.65rem 1.5rem; border-radius: 3px; border: none; font-weight: 600; cursor: pointer; font-size: 0.82rem; transition: all 0.2s;
    font-family: inherit;
  }
  .btn-accept { background: #0a1e3d; color: #fff; }
  .btn-accept:hover { background: #1b3f72; }
  .btn-decline { background: #eef1f5; color: #6b7a8d; }
  .btn-decline:hover { background: #cdd4de; }
</style>
<div id="consent-banner">
  <div class="consent-text">
    Utilizamos cookies para melhorar sua experiência e analisar o tráfego do site. Ao clicar em "Aceitar", você concorda com o uso de cookies para fins de análise e marketing conforme nossa Política de Privacidade.
  </div>
  <div class="consent-btns">
    <button class="btn-consent btn-decline" onclick="rejectConsent()">Negar</button>
    <button class="btn-consent btn-accept" onclick="acceptConsent()">Aceitar</button>
  </div>
</div>
<script is:inline>
  function showBanner() {
    if (!localStorage.getItem('cymh_consent')) {
      document.getElementById('consent-banner').style.display = 'flex';
    }
  }
  function acceptConsent() {
    const consentObj = {
      'ad_storage': 'granted',
      'ad_user_data': 'granted',
      'ad_personalization': 'granted',
      'analytics_storage': 'granted'
    };
    gtag('consent', 'update', consentObj);
    localStorage.setItem('cymh_consent', JSON.stringify(consentObj));
    document.getElementById('consent-banner').style.display = 'none';
  }
  function rejectConsent() {
    const consentObj = {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied'
    };
    gtag('consent', 'update', consentObj);
    localStorage.setItem('cymh_consent', JSON.stringify(consentObj));
    document.getElementById('consent-banner').style.display = 'none';
  }
  window.addEventListener('load', showBanner);
</script>
